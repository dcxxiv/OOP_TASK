#include<iostream>
using namespace std;

class Shape{
protected:
    double length;
    double width;
    double radius;

public:
    void setValues(double l, double w, double r){
        length = l;
        width = w;
        radius = r;
    }
};

class Circle : public Shape{
public:
    void area(){
        cout << "Area of Circle = " << 3.14 * radius * radius << endl;
    }
};

class Rectangle : public Shape{
public:
    void area(){
        cout << "Area of Rectangle = " << length * width << endl;
    }
};
class Oval : public Shape{
public:
    void area(){
        cout << "Area of Oval = " << 3.14 * length * width << endl;
    }
};int main(){

    Circle c;
    Rectangle r;
    Oval o;

    c.setValues(0,0,5);
    r.setValues(10,5,0);
    o.setValues(6,4,0);

    c.area();
    r.area();
    o.area();

    return 0;
}
